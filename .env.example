# Copy to .env.local and fill in values for local development.
# Never commit .env.local — it is in .gitignore.

# Authentik OIDC authority URL.
# Local: http://192.168.1.21:9000/application/o/blueprinted/
# Tunnel: https://auth.blueprinted.io/application/o/blueprinted/
VITE_OIDC_AUTHORITY=

# OIDC client ID registered in Authentik
VITE_OIDC_CLIENT_ID=

# Backend API base URL.
# Local: http://192.168.1.21:8000
# Tunnel: https://api.blueprinted.io
VITE_API_BASE_URL=http://localhost:8000
