# Copy to .env.local and fill in values for local development.
# Never commit .env.local — it is in .gitignore.

# Authentik OIDC authority URL (e.g. https://auth.example.com/application/o/blueprinted/)
VITE_OIDC_AUTHORITY=

# OIDC client ID registered in Authentik
VITE_OIDC_CLIENT_ID=

# Backend API base URL (used by Vite dev proxy; defaults to http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
